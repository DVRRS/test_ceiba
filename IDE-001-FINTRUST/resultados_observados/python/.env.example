# ========================================
# GCP Configuration
# ========================================
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=your-region
DEBUG=false

# Service account (solo para local, NO necesario en Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ========================================
# BigQuery Datasets
# ========================================
BQ_DATASET_RAW=your_raw_dataset
BQ_DATASET_CLEAN=your_clean_dataset
BQ_DATASET_REJECTS=your_rejects_dataset
BQ_DATASET_DATAMART=your_datamart_dataset

# ========================================
# Optional: Override Raw Table Names
# ========================================
BQ_TABLE_CUSTOMERS=customers
BQ_TABLE_LOANS=loans
BQ_TABLE_INSTALLMENTS=installments
BQ_TABLE_PAYMENTS=payments

# ========================================
# Watermark Columns (para deduplicación)
# ========================================
CUSTOMERS_WATERMARK_COL=created_at
LOANS_WATERMARK_COL=origination_date
INSTALLMENTS_WATERMARK_COL=due_date
PAYMENTS_WATERMARK_COL=loaded_at
